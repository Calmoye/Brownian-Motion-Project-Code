def update(frame_idx):
    ax.clear()

    #Display current video frame throughout animation
    ax.imshow(frames[frame_idx], cmap="gray")

    #Get particle trajectory history up to current frame
    current_tracks = tlop0_clean[
        tlop0_clean["frame"] <= frame_idx
    ]

    # This function draws the line for each particle
    if not current_tracks.empty:
        for particle_id, group in current_tracks.groupby("particle"):
            # Ensure coordinates match (cartesian)
            ax.plot(group["x"], group["y"], lw=1.5)

    ax.set_title(f"Frame {frame_idx + 1} / {len(frames)}", fontsize=12)
    ax.set_xlabel("X (px)")
    ax.set_ylabel("Y (px)")


# Create animation (50 ms per frame = 5 fps)
