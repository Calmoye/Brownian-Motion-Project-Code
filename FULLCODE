time = emlop0.index.values
msd = emlop0.values
#linregress is a scipy module that fits two arrays of data into a straight line using least squares
#r_value = correlation coefficient (Indicates how accurate the linear relation is between 2 variables)
#p_value = assesses the significance of the slope (testing the null hypothesis)
#std_err is just the standard error of the slope, a feature of linregress
counts = tlop0_clean.groupby('particle').apply(
    lambda t: t['frame'].max() - t['frame'].min() + 1
)
min_track_frames = counts.min()
print(f"Shortest track spans {min_track_frames} frames")

# only trust emsd out to that many lag steps
max_reliable_lag = time[min_track_frames - 1] if min_track_frames <= len(time) else time[-1]
reliable_time = time[time <= max_reliable_lag]
reliable_msd = msd[time <= max_reliable_lag]

slope, intercept, r_value, p_value, std_err = linregress(reliable_time, reliable_msd)
diffusion_coefficient = slope / 4
error_diffusion_coefficient = std_err / 4

print(r_value)
#Having a value very close to +1 suggests strong correlation between time and MSD
print(p_value)
#Having a value this low concludes that the slope is statistically significant and rejecting the null hypothesis, which supports our idea of diffusion
print(diffusion_coefficient)
print(error_diffusion_coefficient)

